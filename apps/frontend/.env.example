# QRDrop frontend environment (PLAN.md §18)
#
# Copy to `.env.local` for development. Vite only exposes variables prefixed
# with VITE_. Never put secrets here — everything in this file ships to the
# browser.

# Signaling worker base URL. Must use the ws:// or wss:// scheme; the app derives
# the matching http(s) base for the GET /session/new call from it.
#
# `wrangler dev` (run from apps/signaling-worker) serves the worker on port 8787.
VITE_SIGNALING_URL=ws://localhost:8787

# Public origin this app is served from. QR codes encode
# `{VITE_APP_URL}/session?code=XXXXXXXX`, so this must be an origin the peer
# device can actually reach.
#   - Local dev on one machine:  http://localhost:5173
#   - Testing phone → laptop:    http://<your-lan-ip>:5173
#   - Production:                https://qrdrop.app
VITE_APP_URL=http://localhost:5173
